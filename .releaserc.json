{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "uv version ${nextRelease.version} && uv lock && sed -i 's/__version__ = \"[^\"]*\"/__version__ = \"${nextRelease.version}\"/' src/mataki/_version.py"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["pyproject.toml", "uv.lock", "src/mataki/_version.py"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github"
  ]
}
